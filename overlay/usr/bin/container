#!/usr/bin/env bash
set -eo pipefail
source /usr/bin/entrypoint

for FILE in $(find /etc/container.d -type f -iname \*.sh | sort); do
    source ${FILE}
done

pushd ${MINECRAFT_GAME_DIR} >/dev/null
    NEOFORGE_ARGS="libraries/net/neoforged/neoforge/${NEOFORGE_VERSION}/unix_args.txt"

    if [ ! -f "${NEOFORGE_ARGS}" ]; then
        echo "! missing neoforge args file: ${MINECRAFT_GAME_DIR}/${NEOFORGE_ARGS}"
        exit 1
    fi

    STARTCMD="su-exec minecraft java"

    if [ -n "${MINECRAFT_MAXHEAP}" ]; then
        STARTCMD="${STARTCMD} -Xmx${MINECRAFT_MAXHEAP}"
    fi

    if [ -n "${MINECRAFT_MINHEAP}" ]; then
        STARTCMD="${STARTCMD} -Xms${MINECRAFT_MINHEAP}"
    fi

    echo "> starting neoforge ${NEOFORGE_VERSION} server"
    exec ${STARTCMD} ${JAVA_OPTS} @${NEOFORGE_ARGS} ${MINECRAFT_OPTS}
popd >/dev/null
